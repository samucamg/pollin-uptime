# ==============================================================================
# pollin-uptime: Chave Secreta Upstream (Cloudflare Workers Deploy)
# ==============================================================================
# O botão "Deploy to Cloudflare" trata TODAS as variáveis deste arquivo como
# campos de senha OBRIGATÓRIOS. Por isso, mantemos aqui APENAS a chave principal
# da Pollinations.
#
# Obtenha sua chave em: https://enter.pollinations.ai/keys
# ==============================================================================

POLLINATIONS_API_KEY=

# ==============================================================================
# CHAVES E SEGREDOS OPCIONAIS ADICIONAIS:
# Se você quiser configurar chaves opcionais (como AUTH_TOKEN para proteger o gateway,
# chave do Tavily, Serper, Firecrawl ou Groq para fallback externo), adicione-as
# diretamente no Cloudflare Dashboard após o deploy:
#
#   Cloudflare Dashboard ➔ Workers & Pages ➔ pollin-uptime ➔ Settings ➔ Variables and Secrets ➔ Add Secret
#
# Exemplos:
#   AUTH_TOKEN = sua_senha_mestra_privada
#   EXTERNAL_FALLBACK_KEY = gsk_sua_chave_groq
#   SEARCH_PROVIDER_1_KEY = tvly-sua_chave_tavily
#   SEARCH_PROVIDER_2_KEY = sua_chave_serper
#   FETCH_PROVIDER_2_KEY = fc-sua_chave_firecrawl
# ==============================================================================
